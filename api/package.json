{
  "name": "kojo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "deploy": "wrangler deploy --env=\"\" --minify",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{ts,json}\"",
    "lint": "prettier --check \"src/**/*.ts\" \"*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@supabase/supabase-js": "2.119.2",
    "hono": "4.13.23",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261127.1",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}
